{
  "name": "runlab",
  "private": true,
  "workspaces": ["client", "server"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently --kill-others --names server,client \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "test": "npm test --workspace=server",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  }
}
